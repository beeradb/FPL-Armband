
.cache/
.claude/settings.local.json
.claude/worktrees/
.DS_Store
/armband
# Build output
# Claude Code local settings (machine-specific permissions)
# Diagnostic sweep binary
# FPL API response cache
# Generated reports (remove this line if you want to track them)
# Local config may contain your FPL entry id
# macOS
# Plots and inference tables from stats/sweep_inference.R
config.local.json
armband-sweep
reports
reports/
stats/out/
tmp-review/
/priorblend

# Python bytecode from the harvest scripts
__pycache__/
*.pyc
.claude/hooks/

# Scratch the visual-regression browser writes into. Not t.TempDir(): chromium is a
# snap and gets a private /tmp, so the screenshot has to land somewhere the host shares.
cmd/armband/.visualwork-*

# Failure artefacts from the visual regression. The goldens are committed; these are
# what the run produced and how it differed, and they are regenerated on every failure.
cmd/armband/testdata/golden/diff-*.png

# Scratch commit messages written by tooling; never part of the tree.
.commitmsg

# Scratch the browser tests write into. Not t.TempDir(): chromium is a snap and gets a
# private /tmp, so anything it writes has to land somewhere the host shares.
**/.browserwork-*

# Failure artefacts from the layout suite. The goldens are committed; these are what the
# run produced and how it differed.
internal/webui/testdata/golden/diff-*.png

# One-shot edit scripts. They are written, run once and deleted; two were committed by
# accident and carried verbatim copies of intermediate source with them.
.*.py

# The accuracy snapshot's four canonical files (internal/snapshot/values.go's MarkdownFile,
# ValuesFile, ConstantsFile, watched.go's KeyFile) — never committed as of 2026-08-22. The
# series now publishes as a GitHub Release asset (.github/workflows/snapshot.yml); this stops
# `cmd/armband snapshot`'s own default -out=stats/snapshots from landing back in the tree by
# habit, the way 117 prior directories did. NOT a blanket ignore of stats/snapshots/: the
# older evidence directories that remain there (schedule-screen sweeps, xg-repair checks, and
# the rest — see AGENTS.md) name their files after what they measured, never these four, so
# this pattern cannot catch them.
stats/snapshots/*/snapshot.md
stats/snapshots/*/figures.csv
stats/snapshots/*/constants.csv
stats/snapshots/*/key.csv
